---
import Icon from './Icon.astro';
import type { Link } from '../data/links';
import { strings, defaultLang } from '../i18n/strings';

interface Props {
  link: Link;
}

const { link } = Astro.props;
const external = link.download ? {} : { target: '_blank', rel: 'noopener noreferrer' };
---

<a
  href={link.href}
  class:list={['card', { wide: link.wide, accent: link.accent }]}
  style={`view-transition-name: card-${link.id}`}
  download={link.download ? '' : undefined}
  {...external}
>
  <span class="chip"><Icon name={link.icon} size={22} /></span>
  <span class="label" data-i18n={link.label}>{strings[defaultLang][link.label]}</span>
  <Icon name={link.download ? 'download' : 'arrowUpRight'} size={18} class="arrow" />
</a>

<style>
  .card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 10px 18px 10px 10px;
    border-radius: var(--radius);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: var(--shadow);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 1.0625rem;
    -webkit-tap-highlight-color: transparent;
    transition:
      translate 0.2s ease,
      scale 0.15s ease,
      box-shadow 0.2s ease,
      background 0.3s ease;
  }

  .chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--chip);
    transition: background 0.3s ease;
  }

  .label {
    flex: 1;
  }

  .card :global(.arrow) {
    flex: none;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .accent {
    background: var(--accent-bg);
    border-color: transparent;
    color: var(--accent-text);
  }

  .accent .chip {
    background: var(--accent-chip);
  }

  /* Vista bento */
  :global(html[data-view='bento']) .card {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    aspect-ratio: 1;
    padding: 16px;
    border-radius: calc(var(--radius) + 6px);
  }

  :global(html[data-view='bento']) .card.wide {
    grid-column: span 2;
    aspect-ratio: auto;
    min-height: 120px;
  }

  :global(html[data-view='bento']) .chip {
    width: 52px;
    height: 52px;
    border-radius: 16px;
  }

  :global(html[data-view='bento']) .label {
    flex: none;
    font-size: 1.125rem;
  }

  :global(html[data-view='bento']) .card :global(.arrow) {
    position: absolute;
    top: 16px;
    right: 16px;
  }

  /* Interacción */
  .card:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .card:active {
    scale: 0.97;
  }

  @media (hover: hover) {
    .card:hover {
      translate: 0 -3px;
      box-shadow: var(--shadow-hover);
      animation: shake 0.45s ease-in-out;
    }

    .card:hover :global(.arrow) {
      opacity: 1;
    }
  }

  @keyframes shake {
    0%, 100% { rotate: 0deg; }
    20% { rotate: -2deg; }
    40% { rotate: 2deg; }
    60% { rotate: -1.2deg; }
    80% { rotate: 0.6deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      animation: none;
      transition: none;
    }
  }
</style>
