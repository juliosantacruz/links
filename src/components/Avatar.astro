---
interface Props {
  name: string;
  src?: string;
}

const { name, src } = Astro.props;
const initials = name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('');
---

<div class="avatar">
  {src ? <img src={src} alt={name} width="104" height="104" /> : <span aria-hidden="true">{initials}</span>}
</div>

<style>
  .avatar {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    padding: 4px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
  }

  img,
  span {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  img {
    object-fit: cover;
  }

  span {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--c1), var(--c3));
    color: #fff;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
